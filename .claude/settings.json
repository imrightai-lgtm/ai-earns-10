{
  "model": "default",
  "env": {
    "MAX_THINKING_TOKENS": "32000"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/guard-host-exec.mjs\"",
            "timeout": 10,
            "statusMessage": "Проверка: сторонний код — только в песочнице (§3 п.9)"
          }
        ]
      }
    ]
  }
}
